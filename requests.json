    {
      "template": "team-create.yml",
      "action": "create-team",
      "title": "Create a team",
      "intro": "A team is the group of people that owns and joins workspaces. People join it in My Access, approved by its approvers.",
      "fields": [
        {
          "id": "displayName",
          "type": "input",
          "label": "Team name",
          "required": true,
          "description": "Shown in Power BI and Port. The team ID is made from it and never changes.",
          "options": null
        },
        {
          "id": "reach",
          "type": "dropdown",
          "label": "Reach",
          "required": true,
          "description": null,
          "options": [
            {
              "label": "Regional",
              "value": "regional"
            },
            {
              "label": "Global",
              "value": "global"
            }
          ]
        },
        {
          "id": "region",
          "type": "dropdown",
          "label": "Business region",
          "required": true,
          "description": "Not an Azure region. Pick Not regional for a global team.",
          "options": [
            {
              "label": "amer",
              "value": "amer"
            },
            {
              "label": "emea",
              "value": "emea"
            },
            {
              "label": "apac",
              "value": "apac"
            },
            {
              "label": "Not regional",
              "value": null
            }
          ]
        },
        {
          "id": "costCenter",
          "type": "input",
          "label": "Cost center",
          "required": true,
          "description": "One capital letter and four digits, e.g. K1234.",
          "options": null
        },
        {
          "id": "orgUnitType",
          "type": "dropdown",
          "label": "Organisation unit type",
          "required": true,
          "description": null,
          "options": [
            {
              "label": "Department",
              "value": "department"
            },
            {
              "label": "Project",
              "value": "project"
            },
            {
              "label": "Program",
              "value": "program"
            },
            {
              "label": "Initiative",
              "value": "initiative"
            }
          ]
        },
        {
          "id": "orgUnitName",
          "type": "input",
          "label": "Organisation unit name",
          "required": true,
          "description": "e.g. Commercial",
          "options": null
        },
        {
          "id": "approvers",
          "type": "textarea",
          "label": "Approvers",
          "required": true,
          "description": "At least two emails, one per line. They approve people joining the team and changes to it.",
          "options": null
