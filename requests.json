  "schemas": {
    "team": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://platform-gitops.example/schemas/team.v1.schema.json",
      "$comment": "Illustrative stable identifier only; this URL is not deployed. Load this schema from the repository. title, description, examples and x-enum-titles are what requesters read in the request site, the issue forms and the bot's messages; technical notes go in $comment.",
      "title": "Team",
      "description": "A group of people that owns and joins workspaces. People join it in My Access, approved by its approvers.",
      "type": "object",
      "properties": {
        "formatVersion": {
          "const": "v1"
        },
        "kind": {
          "const": "team"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Team ID",
          "description": "Made from the team name when the team is created. It never changes, even when the name does."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "title": "Team name",
          "description": "How the team appears in Power BI, Port and the request forms. The team ID is made from it.",
          "examples": [
            "Finance Analytics"
          ]
        },
        "reach": {
          "enum": [
            "global",
            "regional"
          ],
          "title": "Reach",
          "description": "Whether the team works in one business region or across all of them.",
          "x-enum-titles": {
            "regional": "Regional",
            "global": "Global"
          },
          "x-enum-descriptions": {
            "regional": "Works in one business region",
            "global": "Works across every region"
          }
        },
        "region": {
          "enum": [
            "amer",
            "emea",
            "apac"
          ],
          "$comment": "Placeholder values until the region list is defined.",
          "title": "Business region",
          "description": "The business region the team works in. This is not an Azure region.",
          "x-enum-titles": {
            "amer": "Americas",
            "emea": "Europe, Middle East and Africa",
            "apac": "Asia Pacific"
          }
        },
        "costCenter": {
          "type": "string",
          "pattern": "^[A-Z][0-9]{4}$",
          "title": "Cost center",
          "description": "One capital letter and four digits, for example K1234.",
          "examples": [
            "K1234"
          ]
        },
        "orgUnit": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "department",
                "project",
                "program",
                "initiative"
              ],
              "title": "Organisation unit type",
              "description": "What kind of unit the team belongs to.",
              "x-enum-titles": {
                "department": "Department",
                "project": "Project",
                "program": "Program",
                "initiative": "Initiative"
              }
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "title": "Organisation unit name",
              "description": "The name of that department, project, program or initiative.",
              "examples": [
                "Commercial"
              ]
            }
          },
          "required": [
            "type",
            "name"
          ],
          "additionalProperties": false
        },
        "approvers": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "An email address, for example jo@example.com.",
            "format": "email",
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
          },
          "minItems": 2,
          "uniqueItems": true,
          "title": "Approvers",
          "description": "At least two people, one email per line. They approve who joins the team and any change to it.",
          "examples": [
            "jo@example.com\nkim@example.com"
          ],
          "$comment": "A separate automated flow replaces approvers who leave."
        },
        "workspaces": {
          "type": "array",
          "title": "Workspaces",
          "description": "The workspaces this team owns or has joined, each with one role.",
          "$comment": "One role per workspace (analytics decision 009). Every workspace has exactly one owner team, which also holds the contributor role.",
          "items": {
            "type": "object",
            "properties": {
              "workspace": {
                "type": "string",
                "pattern": "^[0-9]{3}$",
                "title": "Workspace",
                "$comment": "Workspace number, as in desired-state/workspaces/<number>.yaml. Quote it."
              },
              "role": {
                "enum": [
                  "owner",
                  "workspace-contributor",
                  "workspace-observer"
                ],
                "title": "Role",
                "$comment": "Admin is never a team role (analytics decision 003).",
                "x-enum-titles": {
                  "owner": "Owner",
                  "workspace-contributor": "Contributor",
                  "workspace-observer": "Observer"
                },
                "x-enum-descriptions": {
                  "owner": "Accountable for the workspace, approves who joins, and builds in it",
                  "workspace-contributor": "Builds in the workspace",
                  "workspace-observer": "Looks and supports, with no compute"
                }
              }
            },
            "required": [
              "workspace",
              "role"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true
        }
      },
      "required": [
        "formatVersion",
        "kind",
        "id",
        "displayName",
        "reach",
        "costCenter",
        "orgUnit",
        "approvers"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "reach": {
            "const": "regional"
          }
        },
        "required": [
          "reach"
        ]
      },
      "then": {
        "required": [
          "region"
        ]
      },
      "else": {
        "not": {
          "required": [
            "region"
          ]
        }
      }
    },
    "workspace": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://platform-gitops.example/schemas/workspace.v1.schema.json",
      "$comment": "Illustrative stable identifier only; this URL is not deployed. Load this schema from the repository. Cross-file rules (exactly one owning team, numbers) live in gitops/scripts/validate.py. Who may use a workspace lives in the team files (desired-state/teams/). title, description and x-enum-titles are what requesters read; technical notes go in $comment.",
      "title": "Workspace",
      "description": "A place to build and share data work, with a Databricks part, a Power BI part, or both, under one number.",
      "type": "object",
      "x-access-groups": {
        "$comment": "Group names are derived, never chosen (analytics decision 011). The cyber security pipeline creates them; the platform only looks them up (analytics decision 010).",
        "pattern": "SEC-{platform}-{workspace}-{role}",
        "platforms": {
          "databricks": "DBX",
          "powerbi": "PBI"
        },
        "roles": {
          "owner": "Owner",
          "workspace-contributor": "Contributor",
          "workspace-observer": "Observer"
        }
      },
      "properties": {
        "formatVersion": {
          "const": "v1"
        },
        "kind": {
          "const": "workspace"
        },
        "id": {
          "type": "string",
          "pattern": "^(00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$",
          "title": "Workspace number",
          "description": "Set for you when the request is accepted, and never changes.",
          "$comment": "Number 001-999, unique across all platforms. 000 is the shared sandbox groups. The file name is <id>.yaml; quote it."
        },
        "databricks": {
          "type": "object",
          "title": "Databricks",
          "description": "Notebooks, SQL and pipelines on Databricks.",
          "$comment": "A Databricks workspace per listed environment.",
          "properties": {
            "variant": {
              "enum": [
                "serverless",
                "classic"
              ],
              "title": "Databricks type",
              "description": "What the team will mostly do in Databricks.",
              "x-enum-titles": {
                "serverless": "Analyse and report",
                "classic": "Build data pipelines"
              },
              "x-enum-descriptions": {
                "serverless": "SQL, notebooks and dashboards on serverless compute",
                "classic": "Scheduled jobs and pipelines on clusters you configure"
              }
            },
            "environments": {
              "$ref": "#/$defs/environments"
            }
          },
          "required": [
            "variant",
            "environments"
          ],
          "additionalProperties": false
        },
        "powerbi": {
          "type": "object",
          "title": "Power BI",
          "description": "Reports and dashboards in Power BI.",
          "$comment": "A Power BI workspace per listed environment, stg included (analytics decision 014).",
          "properties": {
            "license": {
              "type": "object",
              "properties": {
                "mode": {
                  "enum": [
                    "pro",
                    "premium"
                  ],
                  "title": "Power BI licence",
                  "description": "Pro suits most teams. Premium needs approval from your director and procurement.",
                  "$comment": "premium = a workspace on an F SKU capacity (contract decision 001).",
                  "x-enum-titles": {
                    "pro": "Pro",
                    "premium": "Premium"
                  },
                  "x-enum-descriptions": {
                    "pro": "Shared capacity; everyone who views needs a Pro licence",
                    "premium": "Dedicated capacity; needs director and procurement approval"
                  }
                },
                "capacityRef": {
                  "type": "string",
                  "minLength": 1,
                  "$comment": "Set by platform engineering once procurement assigns a capacity."
                }
              },
              "required": [
                "mode"
              ],
              "additionalProperties": false
            },
            "environments": {
              "$ref": "#/$defs/environments"
            }
          },
          "required": [
            "license",
            "environments"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "formatVersion",
        "kind",
        "id"
      ],
      "anyOf": [
        {
          "required": [
            "databricks"
          ]
        },
        {
          "required": [
            "powerbi"
          ]
        }
      ],
      "additionalProperties": false,
      "$defs": {
        "environments": {
          "type": "array",
          "title": "Environments",
          "description": "Where the workspace exists. dev to try things, stg to test them, prd for real use.",
          "items": {
            "enum": [
              "dev",
              "stg",
              "prd"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  },
